# 构建产物（含签名后的 .app 二进制，体积大且每次编译都变）
build/
*.app/

# 由 assets/icon.svg 生成的二进制图标
# 仓库只保留 svg 源文件；克隆后跑 ./scripts/make-icon.sh（或让 build.sh 自动生成）即可还原
assets/*.icns
assets/*.png

# 本机自签证书产物（从来不该进仓库）
*.p12
*.pem
*.keychain-db
*.pass

# 本地凭证 / 环境变量（口令只放 ~/.viewtimer-sign/，绝不入库）
.env
.env.*
*credentials*

# macOS 杂物
.DS_Store
